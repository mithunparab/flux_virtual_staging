load("@rules_pkg//:pkg.bzl", "pkg_tar")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_push")

pkg_tar(
    name = "app_layer",
    srcs = glob([
        "*.py",
        "*.sh",
        "*.md",
        "requirements.lock",
    ]),
    package_dir = "/app",
)

oci_image(
    name = "image",
    base = "@base_image_repo_linux_amd64",
    tars = [
        ":app_layer",
    ],
    entrypoint = ["/app/run.sh"],
)

oci_push(
    name = "push_image_to_dockerhub",
    image = ":image",
    repository = "index.docker.io/nightfury172/custom_flux_fs",
    remote_tags = ["latest"],
)